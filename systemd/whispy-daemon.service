[Unit]
Description=whispy dictation daemon
Documentation=https://github.com/Ceereals/whispy
# Start only once the compositor is up, so WAYLAND_DISPLAY is in the environment
# for wtype/wl-copy (before that, injection fails).
After=graphical-session.target pipewire.service ydotoold.service
Wants=ydotoold.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/whispy-daemon
Restart=on-failure
RestartSec=2
# whisper-server is launched and supervised as a child by the daemon.

[Install]
WantedBy=graphical-session.target
