class WhispyTray:
    def __init__(self):
        self.state_file = os.path.join(
            os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
            "whispy",
            "state.json"
        )
        state_home = os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))
        self.transcripts_file = os.path.join(state_home, "whispy", "transcripts.jsonl")
        cfg_dir = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
        self.config_file = os.path.join(cfg_dir, "whispy", "config.toml")
        self.muted_by_whispy = False

        self.current_state = "idle"
        self.conn = None
        self.menu_revision = 1
        self.root_menu = None
        self.last_copied_ts = 0.0
        try:
            recent = self.load_recent_transcripts(1)
            if recent:
                self.last_copied_ts = float(recent[0].get("timestamp", 0.0))
        except Exception:
            pass

        # Resolve icon directory
        self.icon_dir = self.resolve_icon_dir()

        # Pre-render pixmaps for crisp vector rendering in Qt / Quickshell
        self.pixmaps = {}
        for state_key, filename in [
            ("idle", "whispy-idle.svg"),
            ("recording", "whispy-recording.svg"),
            ("transcribing", "whispy-transcribing.svg"),
            ("error", "whispy-error.svg"),
        ]:
            path = self.resolve_icon_file(filename)
            self.pixmaps[state_key] = self.render_svg_pixmap(path, 24, 24)

        self.icon_name, self.tooltip_text = self.get_icon_and_tooltip("idle")
        self.rebuild_menu_tree()

    def resolve_icon_dir(self):
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidates = [
            os.path.join(script_dir, "icons"),
            os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps"),
            os.path.expanduser("~/.local/share/whispy/icons"),
            "/usr/local/share/icons/hicolor/scalable/apps",
            "/usr/share/icons/hicolor/scalable/apps",
            "/usr/share/whispy/icons",
        ]
        for c in candidates:
            if os.path.isdir(c):
                return c
        return script_dir

    def resolve_icon_file(self, filename):
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidates = [
            os.path.join(script_dir, "icons", filename),
            os.path.join(script_dir, filename),
            os.path.expanduser(f"~/.local/share/icons/hicolor/scalable/apps/{filename}"),
            os.path.expanduser(f"~/.local/share/whispy/icons/{filename}"),
            f"/usr/local/share/icons/hicolor/scalable/apps/{filename}",
            f"/usr/share/icons/hicolor/scalable/apps/{filename}",
            f"/usr/share/whispy/icons/{filename}",
        ]
        for c in candidates:
            if os.path.isfile(c):
                return c
        return None

    def render_svg_pixmap(self, svg_path, width, height):
        if not svg_path or not os.path.exists(svg_path):
            return []
        try:
            handle = Rsvg.Handle.new_from_file(svg_path)
            pixbuf = handle.get_pixbuf()
            if pixbuf.get_width() != width or pixbuf.get_height() != height:
                pixbuf = pixbuf.scale_simple(width, height, 2)  # INTERP_BILINEAR = 2

            pixels = pixbuf.get_pixels()
            argb = bytearray(len(pixels))
            # Convert RGBA to ARGB big-endian network byte order
            for i in range(0, len(pixels), 4):
                r, g, b, a = pixels[i:i+4]
                argb[i] = a
                argb[i+1] = r
                argb[i+2] = g
                argb[i+3] = b
            return [(width, height, bytes(argb))]
        except Exception as e:
            sys.stderr.write(f"whispy-tray: error rendering {svg_path}: {e}\n")
            return []

    def get_icon_and_tooltip(self, state_str, err_msg=None):
        if state_str == "recording":
            return "whispy-recording", "Whispy: Listening..."
        elif state_str == "transcribing":
            return "whispy-transcribing", "Whispy: Transcribing (GPU)..."
        elif state_str == "error":
            msg = f" ({err_msg})" if err_msg else ""
            return "whispy-error", f"Whispy: Error{msg}"
        else:
            return "whispy-idle", "Whispy: Ready"

    def update_state(self):
        new_state = "idle"
        err_msg = None
        if os.path.exists(self.state_file):
            try:
                with open(self.state_file, "r") as f:
                    data = json.load(f)
                    new_state = data.get("state", "idle")
                    err_msg = data.get("error_message")
            except Exception:
                pass

        if new_state != self.current_state:
            old_state = self.current_state
            self.current_state = new_state
            self.icon_name, self.tooltip_text = self.get_icon_and_tooltip(new_state, err_msg)

            # System audio ducking / muting while recording
            if new_state == "recording" and old_state != "recording":
                self.apply_playback_mute(True)
            elif old_state == "recording" and new_state != "recording":
                self.apply_playback_mute(False)

            # Auto-save transcript to clipboard after dictation finishes
            if new_state in ("success", "idle") and old_state in ("recording", "transcribing", "success"):
                if self.is_save_clipboard_enabled():
                    GLib.timeout_add(100, self.auto_copy_latest_transcript)

            self.rebuild_menu_tree()
            self.emit_signals()
        return True

    def emit_signals(self):
        if not self.conn:
            return
        self.conn.emit_signal(
            None,
            "/StatusNotifierItem",
            "org.kde.StatusNotifierItem",
            "NewIcon",
            None
        )
        self.conn.emit_signal(
            None,
            "/StatusNotifierItem",
            "org.kde.StatusNotifierItem",
            "NewToolTip",
            None
        )
        self.conn.emit_signal(
            None,
            "/MenuBar",
            "com.canonical.dbusmenu",
            "LayoutUpdated",
            GLib.Variant("(ui)", (self.menu_revision, 0))
        )

    # --- StatusNotifierItem handlers ---
    def handle_sni_method(self, conn, sender, object_path, interface_name, method_name, parameters, invocation):
        if method_name == "Activate":
            # Left click: toggle dictation
            subprocess.Popen(["whispy-client", "toggle"])
        elif method_name == "SecondaryActivate":
            # Middle click: cancel dictation
            subprocess.Popen(["whispy-client", "cancel"])
        elif method_name == "ContextMenu":
            # Right click is handled via DBusMenu over /MenuBar when Menu property is present
            pass
        invocation.return_value(None)

    def handle_sni_property(self, conn, sender, object_path, interface_name, property_name):
        if property_name == "Category":
            return GLib.Variant("s", "ApplicationStatus")
        elif property_name == "Id":
            return GLib.Variant("s", "whispy")
        elif property_name == "Title":
            return GLib.Variant("s", "Whispy Dictation")
        elif property_name == "Status":
            return GLib.Variant("s", "Active")
        elif property_name == "IconName":
            return GLib.Variant("s", self.icon_name)
        elif property_name == "IconPixmap":
            pix_data = self.pixmaps.get(self.current_state) or self.pixmaps.get("idle", [])
            return GLib.Variant("a(iiay)", pix_data)
        elif property_name == "IconThemePath":
            return GLib.Variant("s", self.icon_dir)
        elif property_name == "ItemIsMenu":
            return GLib.Variant("b", False)
        elif property_name == "Menu":
            return GLib.Variant("o", "/MenuBar")
        elif property_name == "ToolTip":
            return GLib.Variant("(sa(iiay)ss)", ("", [], "Whispy Dictation", self.tooltip_text))
        return None

    # --- System Audio Muting Helpers ---
    def is_mute_playback_enabled(self):
        if not os.path.isfile(self.config_file):
            return False
        try:
            with open(self.config_file, "rb") as f:
                data = tomllib.load(f)
                return bool(data.get("audio", {}).get("mute_playback", False))
        except Exception:
            return False



    def apply_playback_mute(self, enable):
        if enable:
            if not self.is_mute_playback_enabled():
                return
            # Check if sink is already muted
            try:
                res = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True)
                if "[MUTED]" in res.stdout:
                    self.muted_by_whispy = False
                    return
                subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1"], check=True)
                self.muted_by_whispy = True
            except Exception:
                try:
                    res = subprocess.run(["pactl", "get-sink-mute", "@DEFAULT_SINK@"], capture_output=True, text=True)
                    if "yes" in res.stdout.lower():
                        self.muted_by_whispy = False
                        return
                    subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "1"])
                    self.muted_by_whispy = True
                except Exception:
                    pass
        else:
            if self.muted_by_whispy:
                self.muted_by_whispy = False
                try:
                    subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"])
                except Exception:
                    try:
                        subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "0"])
                    except Exception:
                        pass

    # --- Clipboard Auto-save Helpers ---
    def is_save_clipboard_enabled(self):
        if not os.path.isfile(self.config_file):
            return True
        try:
            with open(self.config_file, "rb") as f:
                data = tomllib.load(f)
                inj = data.get("injection", {})
                if "save_clipboard" in inj:
                    return bool(inj.get("save_clipboard"))
                return bool(data.get("audio", {}).get("save_clipboard", True))
        except Exception:
            return True

    # --- Language Selection Helpers ---
    def get_configured_language(self):
        if not os.path.isfile(self.config_file):
            return "es"
        try:
            with open(self.config_file, "rb") as f:
                data = tomllib.load(f)
                return str(data.get("stt", {}).get("language", "es")).strip().lower()
        except Exception:
            return "es"

    def set_language(self, lang_code):
        if not os.path.isfile(self.config_file):
            return
        try:
            with open(self.config_file, "r", encoding="utf-8") as f:
                content = f.read()

            if re.search(r'(?m)^\s*language\s*=', content):
                content = re.sub(
                    r'(?m)^\s*language\s*=.*$',
                    f'language = "{lang_code}"',
                    content
                )
            else:
                if "[stt]" in content:
                    content = content.replace("[stt]\n", f'[stt]\nlanguage = "{lang_code}"\n')
                else:
                    content += f'\n[stt]\nlanguage = "{lang_code}"\n'

            with open(self.config_file, "w", encoding="utf-8") as f:
                f.write(content)

            # Restart daemon so it loads the new language
            subprocess.Popen(["systemctl", "--user", "restart", "whispy-daemon.service"])

            lang_names = {"es": "Spanish (es)", "en": "English (en)", "auto": "Automatic (auto)"}
            name = lang_names.get(lang_code, lang_code)
            subprocess.Popen([
                "notify-send",
                "-a", "Whispy",
                "-i", "whispy-idle",
                "Dictation Language",
                f"Switched to: {name}"
            ])
            self.rebuild_menu_tree()
            self.emit_signals()
        except Exception as e:
            sys.stderr.write(f"whispy-tray: error updating language: {e}\n")

    # --- History & Clipboard helpers ---
    def load_recent_transcripts(self, limit=10):
        if not os.path.isfile(self.transcripts_file):
            return []
        items = []
        try:
            with open(self.transcripts_file, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        entry = json.loads(line)
                        if entry.get("accepted") and entry.get("text"):
                            items.append(entry)
                    except Exception:
                        continue
        except Exception as e:
            sys.stderr.write(f"whispy-tray: error loading transcripts: {e}\n")
        return items[-limit:][::-1]

    def copy_to_clipboard(self, text, show_notify=True):
        try:
            if shutil.which("wl-copy") and (os.environ.get("WAYLAND_DISPLAY") or not os.environ.get("DISPLAY")):
                subprocess.run(["wl-copy", "--", text], check=True)
            elif shutil.which("xclip"):
                subprocess.run(["xclip", "-selection", "clipboard"], input=text.encode("utf-8"), check=True)
            elif shutil.which("xsel"):
                subprocess.run(["xsel", "--clipboard", "--input"], input=text.encode("utf-8"), check=True)
            else:
                subprocess.run(["wl-copy", "--", text], check=True)

            if show_notify:
                preview = " ".join(text.split())
                if len(preview) > 55:
                    preview = preview[:52] + "..."
                subprocess.Popen([
                    "notify-send",
                    "-a", "Whispy",
                    "-i", "whispy-idle",
                    "Copied to clipboard",
                    preview
                ])
        except Exception as e:
            sys.stderr.write(f"whispy-tray: copy error: {e}\n")

    def auto_copy_latest_transcript(self):
        recent = self.load_recent_transcripts(1)
        if not recent:
            return False
        latest = recent[0]
        ts = float(latest.get("timestamp", 0.0))
        text = latest.get("text", "").strip()
        if ts > self.last_copied_ts and text:
            self.last_copied_ts = ts
            sys.stderr.write(f"whispy-tray: auto-copied latest transcript (ts={ts}) to clipboard\n")
            self.copy_to_clipboard(text, show_notify=False)
        return False

    # --- DBusMenu Tree Construction ---
    def rebuild_menu_tree(self):
        self.menu_revision += 1
        self.menu_items_map = {}

        state = self.current_state
        if state == "recording":
            state_label = "● Recording audio..."
            toggle_label = "Stop and transcribe"
        elif state == "transcribing":
            state_label = "⏳ Transcribing (GPU)..."
            toggle_label = "Start dictation"
        elif state == "error":
            state_label = "⚠️ Status: Error"
            toggle_label = "Start dictation"
        else:
            state_label = "✓ Ready to dictate"
            toggle_label = "Start dictation"

        root_children = []

        # 1. State Header (disabled)
        root_children.append({
            "id": 1,
            "props": {
                "label": GLib.Variant("s", f"Whispy: {state_label}"),
                "enabled": GLib.Variant("b", False),
            },
            "children": [],
        })

        # 2. Separator
        root_children.append({
            "id": 2,
            "props": {"type": GLib.Variant("s", "separator")},
            "children": [],
        })

        # 3. Toggle dictation
        root_children.append({
            "id": 3,
            "props": {
                "label": GLib.Variant("s", toggle_label),
                "enabled": GLib.Variant("b", True),
                "icon-name": GLib.Variant("s", "audio-input-microphone"),
            },
            "children": [],
            "action": lambda: subprocess.Popen(["whispy-client", "toggle"]),
        })

        # 4. Cancel
        root_children.append({
            "id": 4,
            "props": {
                "label": GLib.Variant("s", "Cancel dictation"),
                "enabled": GLib.Variant("b", True),
                "icon-name": GLib.Variant("s", "process-stop"),
            },
            "children": [],
            "action": lambda: (
                subprocess.Popen(["whispy-client", "cancel"]),
                subprocess.Popen(["notify-send", "-a", "Whispy", "-i", "whispy-error", "Dictation cancelled", "Audio capture was discarded"])
            ),
        })

        # 5. Separator
        root_children.append({
            "id": 5,
            "props": {"type": GLib.Variant("s", "separator")},
            "children": [],
        })

        # 6. History Submenu (last 10 transcripts)
        recent = self.load_recent_transcripts(10)
        history_children = []

        if recent:
            for idx, entry in enumerate(recent, 1):
                raw_text = entry["text"].strip()
                preview = " ".join(raw_text.split())
                if len(preview) > 42:
                    preview = preview[:39] + "..."
                item_id = 100 + idx
                history_children.append({
                    "id": item_id,
                    "props": {
                        "label": GLib.Variant("s", f"{idx}. {preview}"),
                        "enabled": GLib.Variant("b", True),
                        "icon-name": GLib.Variant("s", "edit-copy"),
                    },
                    "children": [],
                    "action": (lambda t=raw_text: self.copy_to_clipboard(t)),
                })

            history_children.append({
                "id": 150,
                "props": {"type": GLib.Variant("s", "separator")},
                "children": [],
            })
            history_children.append({
                "id": 151,
                "props": {
                    "label": GLib.Variant("s", "Open full log (transcripts.jsonl)"),
                    "enabled": GLib.Variant("b", True),
                    "icon-name": GLib.Variant("s", "document-open"),
                },
                "children": [],
                "action": lambda: subprocess.Popen(["xdg-open", self.transcripts_file]),
            })
        else:
            history_children.append({
                "id": 101,
                "props": {
                    "label": GLib.Variant("s", "(No recent recordings)"),
                    "enabled": GLib.Variant("b", False),
                },
                "children": [],
            })

        root_children.append({
            "id": 50,
            "props": {
                "label": GLib.Variant("s", f"History ({len(recent)})"),
                "children-display": GLib.Variant("s", "submenu"),
                "icon-name": GLib.Variant("s", "document-open-recent"),
            },
            "children": history_children,
        })

        # 7. Separator
        root_children.append({
            "id": 6,
            "props": {"type": GLib.Variant("s", "separator")},
            "children": [],
        })

        # 7b. Dictation Language (Submenu)
        current_lang = self.get_configured_language()
        lang_label = "Spanish" if current_lang == "es" else ("English" if current_lang == "en" else "Automatic")
        lang_children = [
            {
                "id": 71,
                "props": {
                    "label": GLib.Variant("s", f"{'✓ ' if current_lang == 'es' else '    '}Spanish (es)"),
                    "enabled": GLib.Variant("b", True),
                },
                "children": [],
                "action": lambda: self.set_language("es"),
            },
            {
                "id": 72,
                "props": {
                    "label": GLib.Variant("s", f"{'✓ ' if current_lang == 'en' else '    '}English (en)"),
                    "enabled": GLib.Variant("b", True),
                },
                "children": [],
                "action": lambda: self.set_language("en"),
            },
            {
                "id": 73,
                "props": {
                    "label": GLib.Variant("s", f"{'✓ ' if current_lang == 'auto' else '    '}Automatic (auto)"),
                    "enabled": GLib.Variant("b", True),
                },
                "children": [],
                "action": lambda: self.set_language("auto"),
            },
        ]
        root_children.append({
            "id": 70,
            "props": {
                "label": GLib.Variant("s", f"Language: {lang_label}"),
                "children-display": GLib.Variant("s", "submenu"),
                "icon-name": GLib.Variant("s", "preferences-desktop-locale"),
            },
            "children": lang_children,
        })

        # 8. Configuration
        config_path = self.config_file
        root_children.append({
            "id": 7,
            "props": {
                "label": GLib.Variant("s", "Edit configuration (config.toml)"),
                "enabled": GLib.Variant("b", True),
                "icon-name": GLib.Variant("s", "preferences-system"),
            },
            "children": [],
            "action": lambda: subprocess.Popen(["xdg-open", config_path]),
        })

        # 10. Restart daemon
        root_children.append({
            "id": 8,
            "props": {
                "label": GLib.Variant("s", "Restart daemon (whispy-daemon)"),
                "enabled": GLib.Variant("b", True),
                "icon-name": GLib.Variant("s", "view-refresh"),
            },
            "children": [],
            "action": lambda: (
                subprocess.Popen(["systemctl", "--user", "restart", "whispy-daemon.service"]),
                subprocess.Popen(["notify-send", "-a", "Whispy", "-i", "whispy-idle", "Whispy", "Restarting whispy-daemon..."])
            ),
        })

        # 11. Separator
        root_children.append({
            "id": 9,
            "props": {"type": GLib.Variant("s", "separator")},
            "children": [],
        })

        # 12. Quit
        root_children.append({
            "id": 10,
            "props": {
                "label": GLib.Variant("s", "Quit"),
                "enabled": GLib.Variant("b", True),
                "icon-name": GLib.Variant("s", "application-exit"),
            },
            "children": [],
            "action": lambda: (
                self.apply_playback_mute(False),
                subprocess.Popen(["systemctl", "--user", "stop", "whispy-tray.service"])
            ),
        })

        self.root_menu = {
            "id": 0,
            "props": {"children-display": GLib.Variant("s", "submenu")},
            "children": root_children,
        }

        def index_items(item):
            self.menu_items_map[item["id"]] = item
            for c in item.get("children", []):
                index_items(c)

        index_items(self.root_menu)

    def serialize_item_tuple(self, item, depth, max_depth, property_names):
        props = dict(item["props"])
        if property_names:
            props = {k: v for k, v in props.items() if k in property_names}

        if max_depth == 0 or (max_depth > 0 and depth >= max_depth):
            children_vars = []
        else:
            children_vars = [
                GLib.Variant("(ia{sv}av)", self.serialize_item_tuple(c, depth + 1, max_depth, property_names))
                for c in item.get("children", [])
            ]
        return (item["id"], props, children_vars)

    # --- DBusMenu Handlers ---
    def handle_dbusmenu_method(self, conn, sender, object_path, interface_name, method_name, parameters, invocation):
        if method_name == "GetLayout":
            parent_id, recursion_depth, property_names = parameters.unpack()
            target_item = self.menu_items_map.get(parent_id, self.root_menu)
            serialized = self.serialize_item_tuple(target_item, 0, recursion_depth, property_names)
            invocation.return_value(GLib.Variant("(u(ia{sv}av))", (self.menu_revision, serialized)))

        elif method_name == "GetGroupProperties":
            ids, property_names = parameters.unpack()
            res = []
            for i in ids:
                if i in self.menu_items_map:
                    props = dict(self.menu_items_map[i]["props"])
                    if property_names:
                        props = {k: v for k, v in props.items() if k in property_names}
                    res.append((i, props))
            invocation.return_value(GLib.Variant("(a(ia{sv}))", (res,)))

        elif method_name == "GetProperty":
            item_id, name = parameters.unpack()
            val = GLib.Variant("s", "")
            if item_id in self.menu_items_map:
                val = self.menu_items_map[item_id]["props"].get(name, GLib.Variant("s", ""))
            invocation.return_value(GLib.Variant("(v)", (val,)))

        elif method_name == "AboutToShow":
            self.rebuild_menu_tree()
            invocation.return_value(GLib.Variant("(b)", (False,)))

        elif method_name == "AboutToShowGroup":
            self.rebuild_menu_tree()
            invocation.return_value(GLib.Variant("(aiai)", ([], [])))

        elif method_name == "Event":
            item_id, event_id, data, timestamp = parameters.unpack()
            if event_id == "clicked" and item_id in self.menu_items_map:
                action = self.menu_items_map[item_id].get("action")
                if action:
                    action()
            invocation.return_value(None)

        elif method_name == "EventGroup":
            events = parameters.unpack()[0]
            for item_id, event_id, data, timestamp in events:
                if event_id == "clicked" and item_id in self.menu_items_map:
                    action = self.menu_items_map[item_id].get("action")
                    if action:
                        action()
            invocation.return_value(GLib.Variant("(ai)", ([],)))

        else:
            invocation.return_value(None)

    def handle_dbusmenu_property(self, conn, sender, object_path, interface_name, property_name):
        if property_name == "Version":
            return GLib.Variant("u", 3)
        elif property_name == "Status":
            return GLib.Variant("s", "normal")
        elif property_name == "TextDirection":
            return GLib.Variant("s", "ltr")
        elif property_name == "IconThemePath":
            return GLib.Variant("as", [])
        return None

def main():
    tray = WhispyTray()
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    tray.conn = bus

    sni_node_info = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
    bus.register_object(
        "/StatusNotifierItem",
        sni_node_info.interfaces[0],
        tray.handle_sni_method,
        tray.handle_sni_property,
        None
    )

    dbusmenu_node_info = Gio.DBusNodeInfo.new_for_xml(DBUSMENU_XML)
    bus.register_object(
        "/MenuBar",
        dbusmenu_node_info.interfaces[0],
        tray.handle_dbusmenu_method,
        tray.handle_dbusmenu_property,
        None
    )

    # Register with watcher
    def register_watcher():
        try:
            bus.call_sync(
                "org.kde.StatusNotifierWatcher",
                "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher",
                "RegisterStatusNotifierItem",
                GLib.Variant("(s)", ("/StatusNotifierItem",)),
                None,
                Gio.DBusCallFlags.NONE,
                2000,
                None
            )
        except Exception as e:
            sys.stderr.write(f"whispy-tray: watcher registration retry: {e}\n")
            return True  # retry
        return False  # registered successfully

    if register_watcher():
        GLib.timeout_add_seconds(3, register_watcher)

    # Initial check
    tray.update_state()

    # Poll state.json every 50ms for instant icon reaction
    GLib.timeout_add(50, tray.update_state)

    loop = GLib.MainLoop()

    def handle_signal(*args):
        tray.apply_playback_mute(False)
        loop.quit()

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    loop.run()

if __name__ == "__main__":
    main()
